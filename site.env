# Plain facts about this site. NO secrets here.
SITE=wallykroeker
STAGING_HOST=web-staging.apps.kroeker.fun
STAGING_PORT=8104
PROD_HOST=wallykroeker-prod.apps.kroeker.fun
PROD_PORT=8104
HEALTH_PATH=/
CHECK_PATHS="/ /about /work /print /blog /build-log /blog/2026-03-01-jellyfin-in-7-minutes /tetris /api/tetris/highscores /easter2026 /api/easter2026/photos /sitemap.xml /robots.txt"
# Public repo: web-staging clones over HTTPS, no deploy key needed.
STAGING_REPO=https://github.com/wally-kroeker/wallykroeker.com.git
# Runtime secrets (names only); values live in Infisical <env>:/websites/wallykroeker.
# Staging gets PRINT_NTFY_DRYRUN=1 so a test /print request can never reach Wally's real ntfy inbox.
SECRETS="MANIFESTO_PASSPHRASE PRINT_NTFY_USER PRINT_NTFY_PASSWORD PRINT_NTFY_TOPIC PRINT_NTFY_DRYRUN"
SECRETS_PATH=/websites/wallykroeker
# Named volumes backed up nightly (compose volume names).
VOLUMES="tetris podcast uploads easter print-requests"
